{
  "name": "wooly",
  "private": true,
  "overrides": {
    "postcss": "^8.5.25",
    "esbuild": "^0.28.1",
    "vite": "^7.3.5",
    "@babel/core": "^7.29.6",
    "js-yaml": "^4.2.0",
    "nanoid": "^3.3.18",
    "undici": "^7.29.0",
    "sharp": "^0.35.0"
  },
  "version": "0.0.7",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:site": "next dev --turbopack --port 7014",
    "dev:worker": "cd worker && bun run dev",
    "build": "next build --webpack",
    "start": "next start --port 7014",
    "lint": "biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 . && bun run gate:dynamic-delete && bun run gate:ts-expect-error",
    "lint:fix": "biome check --write --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit:coverage": "vitest run --coverage",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e:bdd": "bunx playwright test",
    "test:worker": "cd worker && bun run test",
    "typecheck:worker": "cd worker && bun x tsc --noEmit",
    "release": "bun scripts/release.ts",
    "prepare": "husky",
    "typecheck": "bash scripts/typecheck.sh",
    "gate:dynamic-delete": "bun run scripts/check-dynamic-delete.ts",
    "gate:ts-expect-error": "bun run scripts/check-ts-expect-error.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "1.33.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "oxc-parser": "0.146.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json}": [
      "biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 --staged"
    ]
  }
}

{
  "name": "wooly",
  "private": true,
  "overrides": {
    "postcss": "^8.5.25",
    "esbuild": "^0.28.1",
    "@babel/core": "^7.29.6",
    "js-yaml": "^4.2.0",
    "nanoid": "^3.3.18",
    "undici": "^7.29.0",
    "picomatch": "4.0.7",
    "rollup": "4.59.0"
  },
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 . && bun run gate:dynamic-delete && bun run gate:ts-expect-error",
    "lint:fix": "biome check --write --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit:coverage": "vitest run --coverage",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e:bdd": "bunx playwright test",
    "test:worker": "vitest run --config worker/vitest.config.ts --coverage",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "release": "bun scripts/release.ts",
    "prepare": "husky",
    "typecheck": "bun run types && tsc --noEmit && bun run typecheck:worker && bun run typecheck:tests",
    "gate:dynamic-delete": "bun run scripts/check-dynamic-delete.ts",
    "gate:ts-expect-error": "bun run scripts/check-ts-expect-error.ts",
    "preview": "vite preview --host 127.0.0.1",
    "types": "wrangler types worker/worker-configuration.d.ts --env-interface WorkerBindings --include-runtime=false --strict-vars=false",
    "deploy": "bun scripts/deploy.ts",
    "deploy:check": "bun run build && wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply DB --local --env local",
    "verify:production": "bun scripts/verify-deployment.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@nocoo/basalt": "2.1.8",
    "clsx": "^2.1.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "react-router": "8.3.1",
    "jose": "6.2.12",
    "valibot": "1.5.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/caveat": "5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.1",
    "husky": "^9.1.7",
    "jsdom": "30.1.0",
    "lint-staged": "17.5.1",
    "oxc-parser": "0.150.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260918.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.0",
    "wrangler": "4.135.0",
    "miniflare": "5.20260918.0-alpha",
    "esbuild": "0.28.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json}": [
      "biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 --staged"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "workerd"
  ]
}

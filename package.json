{
  "name": "wooly",
  "private": true,
  "overrides": {
    "postcss": "^8.5.25",
    "esbuild": "^0.28.2",
    "@babel/core": "^7.29.6",
    "js-yaml": "^4.2.0",
    "nanoid": "^3.3.18",
    "undici": "7.30.1",
    "picomatch": "4.0.7",
    "rollup": "4.59.0",
    "source-map-js": "1.2.2",
    "sharp": "^0.35.5"
  },
  "version": "1.0.9",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 .",
    "lint:fix": "biome check --write --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit:coverage": "vitest run --coverage",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e:bdd": "bunx playwright test",
    "test:worker": "vitest run --config worker/vitest.config.ts --coverage",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "release": "bun scripts/release.ts",
    "prepare": "husky",
    "typecheck": "bun run types && tsc --noEmit && bun run typecheck:worker && bun run typecheck:tests",
    "preview": "vite preview --host 127.0.0.1",
    "types": "wrangler types worker/worker-configuration.d.ts --env-interface WorkerBindings --include-runtime=false --strict-vars=false",
    "deploy": "bun scripts/deploy.ts",
    "deploy:check": "bun run build && wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply DB --local --env local",
    "verify:production": "bun scripts/verify-deployment.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@nocoo/basalt": "^3.6.0",
    "clsx": "^2.1.1",
    "jose": "6.2.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "recharts": "3.11.0",
    "tailwind-merge": "3.7.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@cloudflare/vite-plugin": "1.70.2",
    "@cloudflare/workers-types": "5.20261024.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "miniflare": "5.20261019.2-beta",
    "oxc-parser": "0.160.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.162.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json}": [
      "biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 --staged"
    ]
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.0.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "workerd"
  ]
}

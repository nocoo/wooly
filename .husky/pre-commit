#!/usr/bin/env bash
# L1 + G2a (6DQ): every check runs on the Git index snapshot, not the working tree.
# Re-exec under bash if invoked by sh (husky v9 uses sh -e)
if [ -z "$BASH_VERSION" ]; then
  exec bash "$0" "$@"
fi

set -o pipefail
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/ensure-tools.sh
source "$HOOK_DIR/../scripts/ensure-tools.sh"
require_tool git "index snapshot"
require_tool bun "L1 checks"
require_tool gitleaks "secrets scanning"

snapshot=
TMPDIR_HOOK=
cleanup() {
  status=$?
  trap - EXIT INT TERM HUP
  if [ -n "$TMPDIR_HOOK" ]; then
    rm -rf "$TMPDIR_HOOK" || :
    TMPDIR_HOOK=
  fi
  if [ -n "$snapshot" ]; then
    rm -rf "$snapshot" || :
    snapshot=
  fi
  exit "$status"
}
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" TERM
trap "exit 129" HUP

repo=$(git rev-parse --show-toplevel)
# gitleaks reads the commit index; run before stripping Git hook environment.
gitleaks protect --staged --no-banner

snapshot=$(mktemp -d "${TMPDIR:-/tmp}/wooly-index-XXXXXX")
if ! git checkout-index --all --prefix="$snapshot/"; then
  echo "❌ pre-commit FAILED: git checkout-index for index snapshot." >&2
  exit 1
fi

if [ ! -d "$repo/node_modules" ]; then
  echo "❌ pre-commit: node_modules is required (run bun install --frozen-lockfile)." >&2
  exit 1
fi
if [ ! -f "$snapshot/package.json" ] || [ ! -f "$snapshot/bun.lock" ]; then
  echo "❌ pre-commit: staged package.json and bun.lock are required in the index." >&2
  exit 1
fi
if ! cmp -s "$snapshot/package.json" "$repo/package.json" || ! cmp -s "$snapshot/bun.lock" "$repo/bun.lock"; then
  echo "❌ pre-commit: staged package.json/bun.lock must match the installed worktree copies." >&2
  exit 1
fi

mkdir "$snapshot/node_modules"
for entry in "$repo/node_modules"/*; do
  [ -e "$entry" ] || continue
  ln -s "$entry" "$snapshot/node_modules/${entry##*/}"
done
ln -s "$repo/node_modules/.bin" "$snapshot/node_modules/.bin"
mkdir -p "$snapshot/node_modules/.vite" "$snapshot/node_modules/.vitest" "$snapshot/.cache"

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
export XDG_CACHE_HOME="$snapshot/.cache"
export XDG_STATE_HOME="$snapshot/.cache"
export PATH="$snapshot/node_modules/.bin:$PATH"

TMPDIR_HOOK=$(mktemp -d -t wooly-precommit-XXXXXX)

run_bg() {
  local name="$1"
  shift
  (
    cd "$snapshot" || exit 1
    export XDG_CACHE_HOME="$snapshot/.cache-$name"
    export XDG_STATE_HOME="$XDG_CACHE_HOME"
    mkdir -p "$XDG_CACHE_HOME"
    "$@" >"$TMPDIR_HOOK/$name.log" 2>&1
    echo $? >"$TMPDIR_HOOK/$name.exit"
  ) &
  # shellcheck disable=SC2086
  printf -v "PID_${name}" '%s' "$!"
}

wait_stage() {
  local name="$1"
  local pid_var="PID_${name}"
  local pid status
  pid=${!pid_var}
  wait "$pid" 2>/dev/null || true
  status=$(cat "$TMPDIR_HOOK/$name.exit" 2>/dev/null || echo 1)
  echo "━━━ $name (exit=$status) ━━━"
  cat "$TMPDIR_HOOK/$name.log"
  if [ "$status" -ne 0 ]; then
    echo "❌ pre-commit stage '$name' failed" >&2
    exit "$status"
  fi
}

# Independent L1 stages — all execute inside the index snapshot.
run_bg unit_cov   bun run test:unit:coverage
run_bg worker     bun run test:worker
run_bg api        bun run test:api
run_bg typecheck  bun run typecheck
run_bg lint       bun run lint

wait_stage unit_cov
wait_stage worker
wait_stage api
wait_stage typecheck
wait_stage lint
